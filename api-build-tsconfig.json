{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "/root/Kinosayt-main/apps/api/dist",
    "rootDir": "/root/Kinosayt-main/apps/api/src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["/root/Kinosayt-main/apps/api/src/**/*"]
}
